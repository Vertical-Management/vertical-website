# ── Site ──────────────────────────────────────
# Public canonical URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://somvertical.ad

# ── Contact API (Resend) ──────────────────────
# 1. Create account: https://resend.com
# 2. API Keys → Create
# 3. Domains → add & verify somvertical.ad (or use onboarding sender in tests)
RESEND_API_KEY=

# Inbox that receives form submissions
CONTACT_TO_EMAIL=sales@somvertical.ad

# Verified sender, e.g.:
# CONTACT_FROM_EMAIL=Vertical <sales@somvertical.ad>
# Dev fallback without domain: Vertical <onboarding@resend.dev>
CONTACT_FROM_EMAIL=

# ── Analytics (optional) ──────────────────────
# NEXT_PUBLIC_GA_ID=
