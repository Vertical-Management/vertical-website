{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|run_terminal_command|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${GROK_WORKSPACE_ROOT}/.grok/hooks/scripts/pre-commit-gate.mjs\"",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${GROK_WORKSPACE_ROOT}/.grok/hooks/scripts/session-start-marker.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
